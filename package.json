{
  "name": "vibrant-vue",
  "version": "1.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vibrant-vue.umd.cjs",
  "module": "./dist/vibrant-vue.js",
  "exports": {
    ".": {
      "import": "./dist/vibrant-vue.js",
      "require": "./dist/vibrant-vue.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "update_themes": "node ./generateFinalize.cjs",
    "build": "vite build --config vite.config.js",
    "build:docs": "node generateDocs.cjs",
    "build:translations": "node ./src/messages/runTranslations.js",
    "build:minify": "npm run build && uglifyjs ./dist/vibrantvue.esm.js --compress --output ./dist/vibrantvue.esm.min.js",
    "build:serve": "npm run build:minify && node index.js",
    "build:bulma": "sass --style=expanded --source-map --load-path=node_modules src/css/sass/bulma-skins.scss dist/vibrantvue.css && node ./removeDuplicateVars.mjs && postcss dist/vibrantvue-cleaned.css --no-map --use cssnano --output dist/vibrantvue.min.css",
    "build:full_code": "npm run build:docs && npm run build:minify && npm run build:bulma",
    "build:full": "npm run build:translations && npm run build:full_code",
    "check_duplicates": "npm run build:bulma && node checkDuplicateVars.cjs",
    "serve": "node index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "uuid": "14.0.1",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.1.0",
    "@types/summernote": "0.8.10",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.12.1",
    "bulma": "1.0.4",
    "cssnano": "8.0.2",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "node-fetch": "3.3.2",
    "playwright": "1.61.1",
    "postcss-cli": "11.0.1",
    "sass": "1.101.0",
    "typescript": "6.0.3",
    "uglify-js": "3.19.3",
    "vite": "8.1.2",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-compression": "0.5.1",
    "vitest": "4.1.9",
    "vitest-browser-vue": "2.1.0",
    "vue-docgen-api": "4.79.2",
    "vue-tsc": "3.3.6"
  }
}
